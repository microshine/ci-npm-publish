{
  "name": "@microshine/ci-npm-publish",
  "version": "0.2.1",
  "description": "A small TypeScript package for trying CI releases with GitHub Packages.",
  "type": "module",
  "sideEffects": false,
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changelog": "conventional-changelog -p angular --stdout"
  },
  "author": "microshine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/microshine/ci-npm-publish.git"
  },
  "bugs": {
    "url": "https://github.com/microshine/ci-npm-publish/issues"
  },
  "homepage": "https://github.com/microshine/ci-npm-publish#readme",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@vitest/coverage-v8": "^4.1.5",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
